# PartyLinePager full image: daemon + all transports + wizard + ttyd.
#
# Everything in one container, no Docker socket required. Transports run
# as local processes managed by hooks/plp-runtime.sh in direct mode.
#
# Build:  docker build -f deploy/Dockerfile.full -t party-line-pager-full .
# Run:    docker run -p 7681:7681 -v ./config:/config party-line-pager-full
# Browse: http://localhost:7681
#
# Pin party-line repos to tags at release time:
#   --build-arg TOR_REF=v1.0.0
#   --build-arg I2P_REF=v1.0.0
#   --build-arg RNS_REF=v1.0.0

# ── Stage 1: Rust binaries ───────────────────────────────────────────
FROM rust:1.98.1-slim-trixie AS build
WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libssl-dev git cmake \
 && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates/party-line-pager-core/Cargo.toml crates/party-line-pager-core/Cargo.toml
COPY crates/party-line-pagerd/Cargo.toml crates/party-line-pagerd/Cargo.toml
COPY crates/party-line-pagerctl/Cargo.toml crates/party-line-pagerctl/Cargo.toml

# Dep-cache layer: build once against stubs so this layer caches every
# dependency. Without buildx there is no --mount=type=cache.
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
ARG CMAKE_BUILD_PARALLEL_LEVEL=2
ENV CMAKE_BUILD_PARALLEL_LEVEL=${CMAKE_BUILD_PARALLEL_LEVEL}
RUN mkdir -p crates/party-line-pager-core/src crates/party-line-pagerd/src crates/party-line-pagerctl/src \
 && echo "" > crates/party-line-pager-core/src/lib.rs \
 && echo "" > crates/party-line-pagerd/src/lib.rs \
 && printf 'fn main() {}\n' > crates/party-line-pagerd/src/main.rs \
 && printf 'fn main() {}\n' > crates/party-line-pagerctl/src/main.rs \
 && cargo build --release --workspace --bins

COPY crates ./crates
RUN find crates -name '*.rs' -exec touch {} + \
 && cargo build --release --workspace --bins

# ── Stage 2: Yopass CLI ──────────────────────────────────────────────
FROM golang:1.27.1-bookworm AS yopass-build
ARG YOPASS_VERSION=14.9.0
RUN git clone --depth 1 --branch "${YOPASS_VERSION}" \
        https://github.com/jhaals/yopass.git /src/yopass \
 && cd /src/yopass \
 && go build -o /go/bin/yopass ./cmd/yopass

# ── Stage 3: mkp224o (vanity .onion generator) ───────────────────────
FROM debian:trixie-slim AS mkp224o-builder
ARG MKP224O_REF=5172c0fd71740ca0b11da8149a2575dcf331d7ab
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gcc libc6-dev make autoconf automake \
    libsodium-dev pkg-config git \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/cathugger/mkp224o.git /tmp/mkp224o \
    && cd /tmp/mkp224o \
    && git checkout "${MKP224O_REF}" \
    && ./autogen.sh && ./configure && make

# ── Stage 4: party-line repos ────────────────────────────────────────
FROM alpine/git:v2.54.0 AS party-lines
ARG TOR_REPO=https://gitlab.com/MarcusHoltz/tor-party-line.git
ARG TOR_REF=main
ARG I2P_REPO=https://gitlab.com/MarcusHoltz/i2p-party-line.git
ARG I2P_REF=main
ARG RNS_REPO=https://gitlab.com/MarcusHoltz/reticulum-party-line.git
ARG RNS_REF=main
RUN git clone --depth 1 --branch "$TOR_REF" "$TOR_REPO" /opt/tor-party-line \
 && git clone --depth 1 --branch "$I2P_REF" "$I2P_REPO" /opt/i2p-party-line \
 && git clone --depth 1 --branch "$RNS_REF" "$RNS_REPO" /opt/reticulum-party-line

# ── Stage 5: ttyd static binary ──────────────────────────────────────
FROM debian:trixie-slim AS ttyd-fetch
ARG TTYD_VERSION=1.7.7
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN ARCH="$(uname -m)" \
    && case "$ARCH" in \
        x86_64)        TTYD_ARCH="x86_64" ;; \
        aarch64|arm64) TTYD_ARCH="aarch64" ;; \
        armv7l)        TTYD_ARCH="armhf" ;; \
        *)             TTYD_ARCH="x86_64" ;; \
    esac \
    && curl -fsSL -o /usr/local/bin/ttyd \
        "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${TTYD_ARCH}" \
    && chmod +x /usr/local/bin/ttyd

# ── Stage 6: signal-cli-rest-api ─────────────────────────────────────
FROM bbernhard/signal-cli-rest-api:0.100 AS signal-cli

# ── Stage 7: runtime ─────────────────────────────────────────────────
FROM debian:trixie-slim

# Union of all transport deps + daemon runtime.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    # common
    ca-certificates curl tini bash \
    # tor
    tor libsodium23 \
    # i2p
    i2pd iproute2 \
    # python for reticulum + apprise
    python3 python3-pip \
    # shared across transports
    socat libopus0 openssl \
    qrencode ncurses-bin \
    procps coreutils util-linux \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Reticulum python deps + Apprise for fanout.
RUN pip install --no-cache-dir --break-system-packages rns==1.5.4 lxmf==1.1.1 apprise==1.13.1 \
 && apt-get purge -y --auto-remove python3-pip \
 && rm -rf /var/lib/apt/lists/*

# Rust binaries.
COPY --from=build /src/target/release/party-line-pagerd /usr/local/bin/party-line-pagerd
COPY --from=build /src/target/release/party-line-pagerctl /usr/local/bin/party-line-pagerctl
COPY --from=yopass-build /go/bin/yopass /usr/local/bin/yopass
COPY --from=mkp224o-builder /tmp/mkp224o/mkp224o /usr/local/bin/mkp224o

# ttyd.
COPY --from=ttyd-fetch /usr/local/bin/ttyd /usr/local/bin/ttyd

# signal-cli-rest-api in native mode (no JVM). The Go binary hardcodes
# os.Stat("/usr/bin/signal-cli-native") for its native-support check, so
# the GraalVM binary must live at exactly that path. COPY dereferences the
# upstream symlink into the real 371MB binary, which is what we want here.
COPY --from=signal-cli /usr/bin/signal-cli-native /usr/bin/signal-cli-native
COPY --from=signal-cli /usr/bin/signal-cli-rest-api /usr/local/bin/signal-cli-rest-api
COPY --from=signal-cli /usr/bin/signal-cli-rest-api_plugin_loader.so /usr/local/bin/signal-cli-rest-api_plugin_loader.so

# Party-line repos.
COPY --from=party-lines /opt/tor-party-line /opt/tor-party-line
COPY --from=party-lines /opt/i2p-party-line /opt/i2p-party-line
COPY --from=party-lines /opt/reticulum-party-line /opt/reticulum-party-line
RUN chmod +x /opt/tor-party-line/docker/entrypoint.sh \
             /opt/tor-party-line/tor-party-line.sh \
             /opt/i2p-party-line/i2p-party-line.sh \
             /opt/reticulum-party-line/docker/entrypoint.sh \
             /opt/reticulum-party-line/rns-party-line.sh \
 && ln -s /opt/tor-party-line/tor-party-line.sh /tor-party-line.sh

# Hooks, wizard, example configs.
COPY hooks /opt/party-line-pager/hooks
RUN chmod +x /opt/party-line-pager/hooks/*.sh
COPY party-line-pager.sh /opt/party-line-pager/party-line-pager.sh
RUN chmod +x /opt/party-line-pager/party-line-pager.sh
COPY config/policy.example.toml /opt/party-line-pager/policy.example.toml
COPY config/adapters.example.toml /opt/party-line-pager/adapters.example.toml

# Entrypoint.
COPY deploy/entrypoint.full.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Tor needs debian-tor user and dirs.
RUN mkdir -p /var/lib/tor/hidden_service /data/.partyline \
    && chmod 700 /var/lib/tor /var/lib/tor/hidden_service \
    && chown -R debian-tor:debian-tor /var/lib/tor

# Reticulum user (uid 1000) for the reflector process.
RUN useradd -m -u 1000 partyline 2>/dev/null || true

# Runtime env.
ENV PARTY_LINE_PAGER_RUNTIME=direct
ENV SIGNAL_CLI_REST_API_PLUGIN_SHARED_OBJ_DIR=/usr/local/bin/
ENV TOR_PARTYLINE_DIR=/opt/tor-party-line
ENV I2P_PARTYLINE_DIR=/opt/i2p-party-line
ENV RETICULUM_PARTYLINE_DIR=/opt/reticulum-party-line
ENV LANG=C.UTF-8
ENV TERM=xterm

EXPOSE 7681

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
